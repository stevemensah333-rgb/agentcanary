# The dashboard calls its same-origin /api proxy. Configure CANARY_API_URL and
# CANARY_API_TOKEN as server-side Vercel environment variables instead. Never
# place a backend bearer token in a VITE_* variable: Vite embeds it in JS.

# GitHub OAuth App credentials. These are server-side Vercel variables.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://dashboard.example.com/api/auth/callback
GITHUB_ALLOWED_LOGINS=stevemensah333-rgb
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=https://dashboard.example.com
# Local development only: set false to use a local identity without OAuth.
# The server ignores this bypass when NODE_ENV=production.
AUTH_REQUIRED=true

# Local Vite server and deployed API handler; keep these server-side.
CANARY_API_URL=http://127.0.0.1:8001
CANARY_API_TOKEN=
